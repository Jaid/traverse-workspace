{
  "name": "traverse-workspace",
  "version": "0.2.0",
  "type": "module",
  "description": "Build a recursive tree of packages from package.json workspace declarations",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/traverse-workspace.git"
  },
  "imports": {
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "build": "build_lib --terser-strength max",
    "lint": "eslint .",
    "test": "bun test --max-concurrency 1 ./test",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters --pretty false"
  },
  "dependencies": {
    "forward-slash-path": "0.3.0",
    "fs-extra": "11.4.0",
    "globby": "16.2.4"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "eslint-config-jaid": "33.1.1",
    "tsconfig-jaid-bun": "16.0.0",
    "type-fest": "5.10.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "@types/bun": "1.4.2",
    "@types/fs-extra": "11.0.4"
  },
  "sideEffects": false
}
